#X msg 575 310 pitch \$1;
#X obj 330 360 hsl 160 19 -180 180 0 1 empty empty roll\ (deg) -2 -10 0 12 #dfdfdf #000000 #000000 7950 1;
#X floatatom 505 360 6 0 0 0 - - - 0;
#X msg 575 360 roll \$1;
#X obj 330 410 hsl 160 19 -12 12 0 1 empty empty A1\ trim\ (dB) -2 -10 0 12 #dfdfdf #000000 #000000 7950 1;
#X floatatom 505 410 6 0 0 0 - - - 0;
#X msg 575 410 a1 \$1;
#X obj 330 460 hsl 160 19 -12 12 0 1 empty empty A2\ trim\ (dB) -2 -10 0 12 #dfdfdf #000000 #000000 7950 1;
#X floatatom 505 460 6 0 0 0 - - - 0;
#X msg 575 460 a2 \$1;
#X obj 330 510 hsl 160 19 -12 12 0 1 empty empty A3\ trim\ (dB) -2 -10 0 12 #dfdfdf #000000 #000000 7950 1;
#X floatatom 505 510 6 0 0 0 - - - 0;
#X msg 575 510 a3 \$1;
#X msg 330 570 print;
