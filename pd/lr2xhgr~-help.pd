#X obj 200 300 noise~;
#X obj 90 340 *~ 0;
#X obj 200 340 *~ 0;
#X obj 20 620 lr2xhgr~;
#X obj 330 210 hsl 160 19 0 360 0 1 empty empty divergence\ (deg) -2 -10 0 12 #dfdfdf #000000 #000000 3975 1;
#X floatatom 505 210 6 0 0 0 - - - 0;
#X msg 575 210 divergence \$1;
#X obj 330 260 hsl 160 19 -180 180 0 1 empty empty yaw\ (deg) -2 -10 0 12 #dfdfdf #000000 #000000 7950 1;
#X floatatom 505 260 6 0 0 0 - - - 0;
#X msg 575 260 yaw \$1;
#X obj 330 310 hsl 160 19 -180 180 0 1 empty empty pitch\ (deg) -2 -10 0 12 #dfdfdf #000000 #000000 7950 1;
