#N canvas 40 40 900 760 12;
#X text 20 15 m2xhgr~ - mono to AmbiX by Haar wavelet decomposition (seam-ltm);
#X text 20 45 Creation arguments: yaw pitch roll (degrees) a1 a2 a3 (dB). Missing ones default to 0. Outlets: W Y Z X (AmbiX ACN)., f 90;
#X text 20 95 The Haar band split is tuned for 48 kHz: at another rate the object warns in the console and the frequency-to-space mapping shifts. Messages move a parameter along a 20 ms ramp \; out-of-range values are clipped. Same DSP as the seam-ltm VST3 plugin., f 90;
#X text 20 170 input;
#X obj 20 200 tgl 19 0 empty empty adc~ 24 10 0 12 #dfdfdf #000000 #000000 0 1;
#X obj 130 200 tgl 19 0 empty empty noise~ 24 10 0 12 #dfdfdf #000000 #000000 0 1;
#X obj 130 240 * 0.1;
#X obj 20 280 adc~ 1;
#X obj 130 280 noise~;
#X obj 20 320 *~ 0;
#X obj 130 320 *~ 0;
#X obj 20 560 m2xhgr~;
#X obj 300 190 hsl 160 19 -180 180 0 1 empty empty yaw\ (deg) -2 -10 0 12 #dfdfdf #000000 #000000 7950 1;
#X floatatom 475 190 6 0 0 0 - - - 0;
#X msg 545 190 yaw \$1;
#X obj 300 240 hsl 160 19 -180 180 0 1 empty empty pitch\ (deg) -2 -10 0 12 #dfdfdf #000000 #000000 7950 1;
#X floatatom 475 240 6 0 0 0 - - - 0;
#X msg 545 240 pitch \$1;
#X obj 300 290 hsl 160 19 -180 180 0 1 empty empty roll\ (deg) -2 -10 0 12 #dfdfdf #000000 #000000 7950 1;
#X floatatom 475 290 6 0 0 0 - - - 0;
#X msg 545 290 roll \$1;
#X obj 300 340 hsl 160 19 -12 12 0 1 empty empty A1\ trim\ (dB) -2 -10 0 12 #dfdfdf #000000 #000000 7950 1;
#X floatatom 475 340 6 0 0 0 - - - 0;
#X msg 545 340 a1 \$1;
#X obj 300 390 hsl 160 19 -12 12 0 1 empty empty A2\ trim\ (dB) -2 -10 0 12 #dfdfdf #000000 #000000 7950 1;
#X floatatom 475 390 6 0 0 0 - - - 0;
#X msg 545 390 a2 \$1;
#X obj 300 440 hsl 160 19 -12 12 0 1 empty empty A3\ trim\ (dB) -2 -10 0 12 #dfdfdf #000000 #000000 7950 1;
#X floatatom 475 440 6 0 0 0 - - - 0;
#X msg 545 440 a3 \$1;
#X msg 300 500 print;
#X text 360 500 posts the object line with the current values: copy it into your patch, f 40;
#X text 20 610 outputs;
