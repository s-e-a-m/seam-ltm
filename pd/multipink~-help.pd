#X obj 220 440 *~ 0;
#X obj 320 220 env~ 4096;
#X obj 320 250 - 100;
#X obj 320 280 vu 15 120 empty ch4 -1 -10 0 12 #404040 #000000 1 0;
#X obj 320 440 *~ 0;
