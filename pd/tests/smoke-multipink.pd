#N canvas 0 50 640 420 12;
#X text 20 360 each outlet: env~ over 0.68 s within 2 dB of 77 (= -23 dBFS RMS) prints 1, f 70;
#X obj 20 20 loadbang;
#X msg 20 60 \; pd dsp 1;
#X obj 20 120 multipink~;
#X obj 20 160 env~ 32768;
#X obj 140 160 env~ 32768;
#X obj 260 160 env~ 32768;
#X obj 380 160 env~ 32768;
#X obj 20 200 f;
#X obj 140 200 f;
#X obj 260 200 f;
#X obj 380 200 f;
#X obj 20 240 expr abs($f1 - 77) < 2;
#X obj 140 240 expr abs($f1 - 77) < 2;
#X obj 260 240 expr abs($f1 - 77) < 2;
#X obj 380 240 expr abs($f1 - 77) < 2;
#X obj 20 280 print mp-1;
#X obj 140 280 print mp-2;
#X obj 260 280 print mp-3;
#X obj 380 280 print mp-4;
#X obj 200 20 del 3000;
#X obj 300 20 del 3500;
#X msg 300 60 \; pd quit;
#X connect 1 0 2 0;
#X connect 1 0 20 0;
#X connect 1 0 21 0;
#X connect 21 0 22 0;
#X connect 3 0 4 0;
#X connect 4 0 8 1;
#X connect 20 0 8 0;
#X connect 8 0 12 0;
#X connect 12 0 16 0;
#X connect 3 1 5 0;
#X connect 5 0 9 1;
#X connect 20 0 9 0;
#X connect 9 0 13 0;
#X connect 13 0 17 0;
#X connect 3 2 6 0;
#X connect 6 0 10 1;
#X connect 20 0 10 0;
#X connect 10 0 14 0;
#X connect 14 0 18 0;
#X connect 3 3 7 0;
#X connect 7 0 11 1;
#X connect 20 0 11 0;
#X connect 11 0 15 0;
#X connect 15 0 19 0;
