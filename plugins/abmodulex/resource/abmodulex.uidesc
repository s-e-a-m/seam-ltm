<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
    <fonts>
        <font font-name="Source Code Pro Light" name="TitleFont" size="20"/>
        <font font-name="Source Code Pro Light" name="SubtitleFont" size="13"/>
        <font font-name="Source Code Pro Light" name="InfoFont" size="12"/>
        <font font-name="Source Code Pro Light" name="ValueFont" size="12"/>
    </fonts>
    <colors>
        <color name="BgDark" rgba="#292c2fff"/>
        <color name="TextLight" rgba="#fcfbfdff"/>
        <color name="SliderTrack" rgba="#444444ff"/>
    </colors>

    <!-- S format. HEADER, SETUP (how the microphone is mounted: the upright
         tetrahedron or its dual, 2026-10-09), FOOTER (logo). -->
    <template name="view" class="CViewContainer" origin="0, 0" size="300, 250"
              minSize="300, 250" maxSize="300, 250"
              background-color="BgDark" background-color-draw-style="filled">

        <view class="CTextLabel" origin="0, 18" size="300, 26" font="TitleFont"
              font-color="TextLight" text-alignment="center" title="SEAM ABMODULEX" transparent="true"/>
        <view class="CTextLabel" origin="0, 46" size="300, 18" font="SubtitleFont"
              font-color="TextLight" text-alignment="center" title="A-format &#x2192; AmbiX" transparent="true"/>
        <view class="CTextLabel" origin="0, 68" size="300, 16" font="InfoFont"
              font-color="TextLight" text-alignment="center"
              title="tetrahedron or its dual &#x2192; A0 A1 A2 A3" transparent="true"/>

        <!-- ── SETUP — the dual reads the slots as LFD RFU RBD LBU: Z
             changes sign, crossfaded in 25 ms ─────────────────────────── -->
        <view class="CTextLabel" origin="0, 96" size="300, 16" font="InfoFont"
              font-color="TextLight" text-alignment="center" title="&#x2014; TETRAHEDRON &#x2014;" transparent="true"/>
        <view class="COptionMenu" origin="70, 114" size="160, 20" control-tag="Tetrahedron"
              font="ValueFont" font-color="TextLight" back-color="SliderTrack"
              frame-color="SliderTrack" frame-width="1" style-no-frame="false"/>

        <!-- ── FOOTER ─────────────────────────────────────────────────── -->
        <view class="CView" origin="30, 154" size="240, 77" bitmap="logo"/>
    </template>

    <bitmaps><bitmap name="logo" path="seam_logo.png"/></bitmaps>
    <control-tags>
        <control-tag name="Tetrahedron" tag="100"/>
    </control-tags>
</vstgui-ui-description>
