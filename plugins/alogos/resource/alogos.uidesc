<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
    <fonts>
        <font font-name="Source Code Pro Light" name="TitleFont" size="20"/>
        <font font-name="Source Code Pro Light" name="SubtitleFont" size="13"/>
        <font font-name="Source Code Pro Light" name="KnobLabelFont" size="12"/>
        <font font-name="Source Code Pro Light" name="ValueFont" size="11"/>
        <font font-name="Source Code Pro Light" name="InfoFont" size="11"/>
    </fonts>
    <colors>
        <color name="BgDark" rgba="#292c2fff"/>
        <color name="TextLight" rgba="#fcfbfdff"/>
        <color name="SliderTrack" rgba="#444444ff"/>
        <color name="SliderActive" rgba="#4a9ec8ff"/>
        <color name="Structure" rgba="#888888ff"/>
    </colors>

    <!-- L format, from the template: six settings (ui-style "L: from about
         six fine controls") and a footer whose decay lines over four faces
         need the 400 px of the L width (INPHIREV, strx). Zone order HEADER,
         SETUP, OPS, FOOTER; no FINE: the six settings are soundcheck values
         declared once, not gestures, so they are SETUP menus and fields,
         three to a row. -->
    <template name="view" class="CViewContainer" origin="0, 0" size="460, 396"
              minSize="460, 396" maxSize="460, 396"
              background-color="BgDark" background-color-draw-style="filled">

        <!-- ── HEADER ─────────────────────────────────────────────────── -->
        <view class="CTextLabel" origin="0, 14" size="460, 26" font="TitleFont"
              font-color="TextLight" text-alignment="center" title="SEAM ALOGOS" transparent="true"/>
        <view class="CTextLabel" origin="0, 42" size="460, 18" font="SubtitleFont"
              font-color="TextLight" text-alignment="center" title="Irrational All-Pass Memory" transparent="true"/>
        <view class="CTextLabel" origin="0, 60" size="460, 14" font="InfoFont"
              font-color="TextLight" text-alignment="center"
              title="4 faces &#xB7; d r^((i+k/4)/D) &#x2192; next prime &#xB7; r = &#x3C6; &#x221A;2 e &#x3C0;" transparent="true"/>

        <!-- ── SETUP — what the user tells the plugin ───────────────────
             Two rows of three blocks (label 14 px, control 20 px, 42 px
             stride). Row one places the STONE: its id (the grid's phase),
             the distance in metres (typed; the field shows the grid point
             the engine takes), the sections (typed; the field shows the
             effective count and "(max N)" when limited). Row two shapes the
             spiral: scale r, density D, all-pass gain g. A new value is
             heard once stable for 250 ms, after a reset of the memory. -->
        <view class="CTextLabel" origin="30, 90" size="120, 14" font="KnobLabelFont"
              font-color="TextLight" text-alignment="center" title="STONE" transparent="true"/>
        <view class="COptionMenu" origin="30, 106" size="120, 20" control-tag="StoneId"
              font="ValueFont" font-color="TextLight" back-color="SliderTrack"
              frame-color="SliderTrack" frame-width="1" style-no-frame="false"/>

        <view class="CTextLabel" origin="170, 90" size="120, 14" font="KnobLabelFont"
              font-color="TextLight" text-alignment="center" title="distance" transparent="true"/>
        <view class="CTextEdit" origin="170, 106" size="120, 20" control-tag="Distance"
              font="ValueFont" font-color="TextLight" text-alignment="center"
              back-color="SliderTrack" frame-color="SliderTrack" frame-width="1"
              style-no-frame="false" transparent="false" value-precision="3"/>

        <view class="CTextLabel" origin="310, 90" size="120, 14" font="KnobLabelFont"
              font-color="TextLight" text-alignment="center" title="sections" transparent="true"/>
        <view class="CTextEdit" origin="310, 106" size="120, 20" control-tag="Sections"
              font="ValueFont" font-color="TextLight" text-alignment="center"
              back-color="SliderTrack" frame-color="SliderTrack" frame-width="1"
              style-no-frame="false" transparent="false" value-precision="0"/>

        <view class="CTextLabel" origin="30, 132" size="120, 14" font="KnobLabelFont"
              font-color="TextLight" text-alignment="center" title="scale" transparent="true"/>
        <view class="COptionMenu" origin="30, 148" size="120, 20" control-tag="Scale"
              font="ValueFont" font-color="TextLight" back-color="SliderTrack"
              frame-color="SliderTrack" frame-width="1" style-no-frame="false"/>

        <view class="CTextLabel" origin="170, 132" size="120, 14" font="KnobLabelFont"
              font-color="TextLight" text-alignment="center" title="density" transparent="true"/>
        <view class="COptionMenu" origin="170, 148" size="120, 20" control-tag="Density"
              font="ValueFont" font-color="TextLight" back-color="SliderTrack"
              frame-color="SliderTrack" frame-width="1" style-no-frame="false"/>

        <view class="CTextLabel" origin="310, 132" size="120, 14" font="KnobLabelFont"
              font-color="TextLight" text-alignment="center" title="g" transparent="true"/>
        <view class="COptionMenu" origin="310, 148" size="120, 20" control-tag="Gain"
              font="ValueFont" font-color="TextLight" back-color="SliderTrack"
              frame-color="SliderTrack" frame-width="1" style-no-frame="false"/>

        <!-- ── OPS ───────────────────────────────────────────────────────
             POWER over the left half, RESET over the right one. RESET is
             UI-only: it empties the memory, it is not a parameter. -->
        <view class="CCheckBox" origin="93, 190" size="14, 14" control-tag="Power"
              boxframe-color="Structure" boxfill-color="BgDark" checkmark-color="SliderActive"
              title="" transparent="true"/>
        <view class="CTextLabel" origin="111, 188" size="52, 16" font="KnobLabelFont"
              font-color="TextLight" text-alignment="left" title="POWER" transparent="true"/>
        <view class="CView" origin="313, 190" size="14, 14" custom-view-name="AlogosReset"
              tooltip="empty the four memories"/>
        <view class="CTextLabel" origin="331, 188" size="52, 16" font="KnobLabelFont"
              font-color="TextLight" text-alignment="left" title="RESET" transparent="true"/>

        <!-- ── FOOTER — what the plugin tells the user, then the logo ────
             The decay each face prints to -30 and -60 dB (an estimate with
             the setting's g), the first and longest delay of the table with
             the effective sections and N_max, the arena and the status. -->
        <view class="CView" origin="30, 224" size="400, 70" custom-view-name="AlogosFooter"/>

        <!-- SEAM logo (native 240x77 — CView does not scale bitmaps) -->
        <view class="CView" origin="110, 308" size="240, 77" bitmap="logo"/>
    </template>

    <bitmaps><bitmap name="logo" path="seam_logo.png"/></bitmaps>
    <control-tags>
        <control-tag name="Power"    tag="100"/>
        <control-tag name="StoneId"  tag="101"/>
        <control-tag name="Distance" tag="102"/>
        <control-tag name="Sections" tag="103"/>
        <control-tag name="Scale"    tag="104"/>
        <control-tag name="Density"  tag="105"/>
        <control-tag name="Gain"     tag="106"/>
    </control-tags>
</vstgui-ui-description>
