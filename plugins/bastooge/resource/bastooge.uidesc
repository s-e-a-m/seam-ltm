<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
    <fonts>
        <font font-name="Source Code Pro Light" name="TitleFont" size="20"/>
        <font font-name="Source Code Pro Light" name="SubtitleFont" size="13"/>
        <font font-name="Source Code Pro Light" name="KnobLabelFont" size="13"/>
        <font font-name="Source Code Pro Light" name="ValueFont" size="12"/>
        <font font-name="Source Code Pro Light" name="InfoFont" size="11"/>
    </fonts>
    <colors>
        <color name="BgDark" rgba="#292c2fff"/>
        <color name="TextLight" rgba="#fcfbfdff"/>
        <color name="SliderTrack" rgba="#444444ff"/>
        <color name="SliderActive" rgba="#4a9ec8ff"/>
        <color name="Structure" rgba="#888888ff"/>
    </colors>

    <!-- S format: three fine controls (one slider, one menu, one toggle) in
         one column at x=20 of width 260, the 300 px type scale (KnobLabel 13,
         Value 12) with Info 11, as in x2uhj, hilbert and ltburst: at 12 the
         readout's longest row would be 302 px, wider than the window. HEADER, FINE, FOOTER: no SETUP, and no OPS,
         since Bypass is not POWER (POWER off means silent; here the matrix
         keeps sounding), so it stays a FINE toggle with a Title Case label. -->
    <template name="view" class="CViewContainer" origin="0, 0" size="300, 392"
              minSize="300, 392" maxSize="300, 392"
              background-color="BgDark" background-color-draw-style="filled">

        <!-- ── HEADER ─────────────────────────────────────────────────── -->
        <view class="CTextLabel" origin="0, 18" size="300, 26" font="TitleFont"
              font-color="TextLight" text-alignment="center" title="SEAM BASTOOGE" transparent="true"/>
        <view class="CTextLabel" origin="0, 46" size="300, 18" font="SubtitleFont"
              font-color="TextLight" text-alignment="center" title="S.T.OOGE mk2g Decoder" transparent="true"/>
        <view class="CTextLabel" origin="0, 66" size="300, 14" font="InfoFont"
              font-color="TextLight" text-alignment="center"
              title="AmbiX &#x2192; LFU RFD RBU LBD" transparent="true"/>

        <!-- ── FINE ───────────────────────────────────────────────────────
             Slider block label 14 / slider 18 / value 16; menu block label
             14 / menu 20; then the toggle, its caption a separate label as
             in multipink, the pair centred on its ink. -->
        <view class="CTextLabel" origin="20, 96" size="260, 14" font="KnobLabelFont"
              font-color="TextLight" text-alignment="center" title="Dipole Cut (Hz)" transparent="true"/>
        <view class="CSlider" origin="20, 112" size="260, 18" control-tag="Cut" default-value="0.5129"
              orientation="horizontal" draw-back="true" draw-back-color="SliderTrack"
              draw-value="true" draw-value-color="SliderActive"
              draw-frame="true" draw-frame-color="SliderTrack"
              frame-width="1" mode="free click" transparent="false"/>
        <view class="CTextEdit" origin="20, 132" size="260, 16" font="ValueFont" control-tag="Cut"
              font-color="TextLight" text-alignment="center" transparent="true"
              value-precision="0" style-no-frame="true"/>

        <view class="CTextLabel" origin="20, 156" size="260, 14" font="KnobLabelFont"
              font-color="TextLight" text-alignment="center" title="Test" transparent="true"/>
        <view class="COptionMenu" origin="80, 172" size="140, 20" control-tag="Test"
              font="ValueFont" font-color="TextLight" back-color="SliderTrack"
              frame-color="SliderTrack" frame-width="1" style-no-frame="false"/>

        <view class="CCheckBox" origin="118, 206" size="14, 14" control-tag="Bypass"
              boxframe-color="Structure" boxfill-color="BgDark" checkmark-color="SliderActive"
              title="" transparent="true"/>
        <view class="CTextLabel" origin="136, 204" size="60, 16" font="KnobLabelFont"
              font-color="TextLight" text-alignment="left" title="Bypass" transparent="true"/>

        <!-- ── FOOTER — the filters in force and the mode, then the logo ──
             Three 16 px rows: the bell, the cut, the status. At InfoFont 11
             a monospace character is 6.6 px wide; the widest row, "TEST X ·
             BYPASS · DIPOLE WITHOUT HIGH-PASS" (42 characters, 277 px), fits
             the 280 px view. The status names a test mode in capitals and
             warns when a dipole test runs with bypass on. -->
        <view class="CView" origin="10, 238" size="280, 48" custom-view-name="BastoogeReadout"/>

        <!-- SEAM logo (native 240x77 — CView does not scale bitmaps) -->
        <view class="CView" origin="30, 298" size="240, 77" bitmap="logo"/>
    </template>

    <bitmaps><bitmap name="logo" path="seam_logo.png"/></bitmaps>
    <control-tags>
        <control-tag name="Cut"    tag="0"/>
        <control-tag name="Test"   tag="1"/>
        <control-tag name="Bypass" tag="2"/>
    </control-tags>
</vstgui-ui-description>
