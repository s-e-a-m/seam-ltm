<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
    <fonts>
        <font font-name="Source Code Pro Light" name="TitleFont" size="20"/>
        <font font-name="Source Code Pro Light" name="SubtitleFont" size="13"/>
        <font font-name="Source Code Pro Light" name="KnobLabelFont" size="13"/>
        <font font-name="Source Code Pro Light" name="ValueFont" size="12"/>
        <font font-name="Source Code Pro Light" name="InfoFont" size="11"/>
    </fonts>
    <colors>
        <color name="BgDark" rgba="#292c2fff"/>
        <color name="TextLight" rgba="#fcfbfdff"/>
        <color name="TextDim" rgba="#888888ff"/>
        <color name="SliderTrack" rgba="#444444ff"/>
        <color name="SliderActive" rgba="#4a9ec8ff"/>
    </colors>

    <template name="view" class="CViewContainer" origin="0, 0" size="300, 450"
              minSize="300, 450" maxSize="300, 450"
              background-color="BgDark" background-color-draw-style="filled">

        <!-- Title -->
        <view class="CTextLabel" origin="0, 18" size="300, 26" font="TitleFont"
              font-color="TextLight" text-alignment="center" title="SEAM MULTIPINK" transparent="true"/>
        <view class="CTextLabel" origin="0, 46" size="300, 18" font="SubtitleFont"
              font-color="TextDim" text-alignment="center" title="Multichannel Pink Noise" transparent="true"/>
        <view class="CTextLabel" origin="0, 66" size="300, 14" font="InfoFont"
              font-color="TextDim" text-alignment="center"
              title="64-slot shared pool · RMS-calibrated" transparent="true"/>

        <!-- Reference (3-step list) -->
        <view class="CTextLabel" origin="20, 100" size="260, 16" font="KnobLabelFont"
              font-color="TextLight" text-alignment="center" title="Reference (dBFS RMS)" transparent="true"/>
        <view class="COptionMenu" origin="80, 120" size="140, 20" control-tag="Reference"
              font="ValueFont" font-color="TextLight" back-color="SliderTrack"
              frame-color="SliderTrack" frame-width="1" style-no-frame="false"/>

        <!-- Trim slider -->
        <view class="CTextLabel" origin="20, 154" size="260, 16" font="KnobLabelFont"
              font-color="TextLight" text-alignment="center" title="Trim (dB)" transparent="true"/>
        <view class="CSlider" origin="20, 174" size="260, 20" control-tag="Trim" default-value="0.5"
              orientation="horizontal" draw-back="true" draw-back-color="SliderTrack"
              draw-value="true" draw-value-color="SliderActive"
              draw-frame="true" draw-frame-color="SliderTrack"
              frame-width="1" mode="free click" transparent="false"/>
        <view class="CTextEdit" origin="20, 196" size="260, 18" font="ValueFont" control-tag="Trim"
              font-color="TextLight" text-alignment="center" transparent="true" value-precision="2" style-no-frame="true"/>

        <!-- Mute -->
        <view class="CCheckBox" origin="100, 222" size="100, 20" control-tag="Mute"
              title="MUTE" font="ValueFont" font-color="TextLight"
              boxframe-color="TextDim" boxfill-color="BgDark" checkmark-color="SliderActive"
              frame-width="1" transparent="true" autosize-to-fit="false"/>

        <!-- STONE identity for the calibration bus. Declared by hand, never
             inferred from the pool slot: with four STONEs in the room, an
             instance that guesses is an instance that calibrates the wrong
             power amp. Default "?" = undeclared, which strx renders "STONE ?". -->
        <view class="CTextLabel" origin="20, 252" size="260, 16" font="KnobLabelFont"
              font-color="TextLight" text-alignment="center" title="STONE" transparent="true"/>
        <view class="COptionMenu" origin="80, 272" size="140, 20" control-tag="StoneId"
              font="ValueFont" font-color="TextLight" back-color="SliderTrack"
              frame-color="SliderTrack" frame-width="1" style-no-frame="false"/>

        <!-- Slot badge -->
        <view class="CTextLabel" origin="20, 302" size="60, 16" font="InfoFont"
              font-color="TextDim" text-alignment="left" title="Slot:" transparent="true"/>
        <view class="CParamDisplay" origin="55, 302" size="40, 16" control-tag="SlotStart"
              font="InfoFont" font-color="TextLight" text-alignment="left" transparent="true" value-precision="0"/>
        <view class="CTextLabel" origin="100, 302" size="60, 16" font="InfoFont"
              font-color="TextDim" text-alignment="left" title="N:" transparent="true"/>
        <view class="CParamDisplay" origin="120, 302" size="40, 16" control-tag="SlotCount"
              font="InfoFont" font-color="TextLight" text-alignment="left" transparent="true" value-precision="0"/>
        <view class="CTextLabel" origin="170, 302" size="110, 16" font="InfoFont"
              font-color="TextDim" text-alignment="right" title="of 64 pool" transparent="true"/>

        <!-- Pool Status -->
        <view class="CTextLabel" origin="20, 322" size="60, 16" font="InfoFont"
              font-color="TextDim" text-alignment="left" title="Status:" transparent="true"/>
        <view class="CParamDisplay" origin="80, 322" size="200, 16" control-tag="PoolStatus"
              font="InfoFont" font-color="TextLight" text-alignment="left" transparent="true" value-precision="0"/>

        <!-- Logo at bottom (native aspect 240x77) -->
        <view class="CView" origin="30, 345" size="240, 77" bitmap="logo"/>
    </template>

    <bitmaps><bitmap name="logo" path="seam_logo.png"/></bitmaps>
    <control-tags>
        <control-tag name="Reference"  tag="100"/>
        <control-tag name="Trim"       tag="101"/>
        <control-tag name="Mute"       tag="102"/>
        <control-tag name="StoneId"    tag="103"/>
        <control-tag name="SlotStart"  tag="200"/>
        <control-tag name="SlotCount"  tag="201"/>
        <control-tag name="PoolStatus" tag="202"/>
    </control-tags>
</vstgui-ui-description>
