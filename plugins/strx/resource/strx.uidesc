<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
    <fonts>
        <font font-name="Source Code Pro Light" name="TitleFont" size="20"/>
        <font font-name="Source Code Pro Light" name="SubtitleFont" size="13"/>
        <font font-name="Source Code Pro Light" name="KnobLabelFont" size="12"/>
        <font font-name="Source Code Pro Light" name="ValueFont" size="11"/>
        <font font-name="Source Code Pro Light" name="InfoFont" size="11"/>
    </fonts>
    <colors>
        <color name="BgDark" rgba="#292c2fff"/>
        <color name="TextLight" rgba="#fcfbfdff"/>
        <color name="TextDim" rgba="#888888ff"/>
        <color name="SliderTrack" rgba="#444444ff"/>
        <color name="SliderActive" rgba="#4a9ec8ff"/>
        <color name="MeterFill" rgba="#c8a24aff"/>
        <color name="MeterInv" rgba="#c04040ff"/>
    </colors>

    <!-- Three-zone frame (Task 6 scaffold): goniometer left (Task 8, StrxGoniometer
         below) / spectrum centre (Task 9, StrxSpectrum below) / meters right
         (Task 7, StrxMeters below), sized to fit the StrxGoniometer /
         StrxSpectrum / StrxMeters custom views reserved in strx_ids.h. -->
    <template name="editor" class="CViewContainer" origin="0, 0" size="900, 360"
              minSize="900, 360" maxSize="900, 360"
              background-color="BgDark" background-color-draw-style="filled">

        <view class="CTextLabel" origin="0, 14" size="900, 26" font="TitleFont"
              font-color="TextLight" text-alignment="center" title="SEAM strx" transparent="true"/>
        <view class="CTextLabel" origin="0, 42" size="900, 18" font="SubtitleFont"
              font-color="TextDim" text-alignment="center" title="STONE observation M/S analyzer" transparent="true"/>

        <!-- Goniometer zone (left third): decaying L/R scatter + Angle/Panorama. -->
        <view class="CView" origin="20, 70" size="260, 260" custom-view-name="StrxGoniometer"
              tooltip="Decaying M/S scatter (Lissajous) with Angle/Panorama readout"/>

        <!-- Spectrum zone (centre third): overlaid M/S Welch curves, log-freq
             20 Hz-20 kHz x-axis, -120..+6 dB y-axis. Kept above the logo
             (origin 330,260) so the two views never overlap. -->
        <view class="CView" origin="290, 70" size="310, 180" custom-view-name="StrxSpectrum"
              tooltip="Overlaid M/S Welch spectra (log frequency, dB)"/>

        <!-- Meters zone (right third): In L / In R / M / S / Width bars. -->
        <view class="CView" origin="610, 70" size="270, 260" custom-view-name="StrxMeters"
              tooltip="In L, In R, M, S levels (dBFS) and Width (correlation-tinted)"/>

        <!-- SEAM logo (native 240x77 — CView does not scale bitmaps) -->
        <view class="CView" origin="330, 260" size="240, 77" bitmap="logo"/>
    </template>

    <bitmaps>
        <bitmap name="logo" path="seam_logo.png"/>
    </bitmaps>
    <control-tags>
    </control-tags>
</vstgui-ui-description>
